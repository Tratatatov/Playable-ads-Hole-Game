{
  "package_version": 2,
  "version": "1.0.0",
  "name": "stencil-material-creator",
  "description": "Creates two pre-configured Stencil Buffer materials for the hole effect",
  "author": "Antigravity",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.extension/Stencil Buffer/Create Stencil Materials",
        "label": "Create Stencil Materials",
        "message": "stencil-material-creator:create"
      }
    ],
    "messages": {
      "stencil-material-creator:create": {
        "methods": [
          "main.createStencilMaterials"
        ]
      }
    }
  }
}
